# Postgres connection strings. Neon, Supabase, and Vercel Postgres all work
# and all give you both a pooled and a direct URL out of the box — copy
# them from that provider's dashboard once the DB is created.
#
# DATABASE_URL: used at runtime, through a connection pooler. Required in
# serverless — every Vercel function invocation can open a fresh
# connection, and Postgres has a low hard connection limit, so
# unpooled connections exhaust it within minutes of real traffic.
DATABASE_URL="postgresql://user:password@host:5432/ielts?sslmode=require&pgbouncer=true"

# DIRECT_URL: bypasses the pooler. Only used by `prisma migrate` / `prisma
# studio`, which need a direct connection to run schema changes.
DIRECT_URL="postgresql://user:password@host:5432/ielts?sslmode=require"

# Long random secret used to sign short-lived (15 min) JWT access tokens.
# Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
